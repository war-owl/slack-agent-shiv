{
  "slack": {
    "botTokenEnvVar": "SLACK_BOT_TOKEN",
    "appTokenEnvVar": "SLACK_APP_TOKEN"
  },
  "vault": {
    "notes": "./vault/Notes",
    "skills": "./vault/Skills"
  },
  "workspaceRoot": "./.workspaces",
  "stateDir": "./.state",
  "operatingManual": "./assets/operating-manual.md",
  "engine": {
    "model": "gpt-5.6-sol",
    "reasoningEffort": "low"
  },
  "bounds": {
    "turnTimeoutMs": 3600000,
    "maxTurnsPerJob": 8,
    "tokenBudgetPerJob": 1000000,
    "maxConcurrentJobs": 4,
    "librarianTimeoutMs": 300000
  },
  "github": {
    "appIdEnvVar": "GITHUB_APP_ID",
    "privateKeyPathEnvVar": "GITHUB_APP_PRIVATE_KEY_PATH",
    "owner": "your-org",
    "repositories": [
      "your-org/your-repo"
    ]
  },
  "connectors": [
    {
      "name": "linear",
      "url": "https://mcp.linear.app/mcp",
      "bearerTokenEnvVar": "LINEAR_API_KEY",

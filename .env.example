# Copy to .env and fill in. **This file holds credentials and nothing else.**
#
# Everything else — the Vault, the Skills, the bounds, the model, and the path to the MCP
# registry — is configured in `open-agent.config.json`. Connectors live in `mcp.json`.
# Both files name these variables and never contain their values. See
# docs/configuration.md and the two example JSON files.
#
# The one exception, because it cannot live inside the file it points at:
# CONFIG_PATH=./open-agent.config.json

# --- Slack -------------------------------------------------------------------
# From your own Slack app (create it from the manifest; do not use a shared app).
# Bot User OAuth Token, under OAuth & Permissions. Checked at startup with auth.test.
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with connections:write, under Basic Information. Socket Mode.
SLACK_APP_TOKEN=xapp-...

# --- GitHub, if you want it --------------------------------------------------
# Create a fine-grained personal access token limited to the repositories and permissions
# this instance needs, then enable the `github` entry in `mcp.json`.
# GITHUB_TOKEN=github_pat_...

# --- Connectors, if you want any --------------------------------------------
# Each connector in `mcp.json` names the variable holding its bearer token.
# Codex reads that variable itself — the wrapper is not in the tool path (ADR-0005) — so
# the token never enters this process.
# LINEAR_API_KEY=lin_api_...
